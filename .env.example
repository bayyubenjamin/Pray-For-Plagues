# Pray For Plagues — copy to .env.local, never commit real values.
# Server-only secrets (no NEXT_PUBLIC_ prefix): NHOST_ADMIN_SECRET,
# X_CLIENT_SECRET. Everything else is public config.

# Public app URL (production)
NEXT_PUBLIC_APP_URL=https://prayforplagues.xyz

# Nhost / Hasura (see NHOST.md)
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=eu-central-1
# Optional override; default is https://<subdomain>.hasura.<region>.nhost.run/v1/graphql
# NHOST_GRAPHQL_URL=
# Server only — also accepted as HASURA_GRAPHQL_ADMIN_SECRET
NHOST_ADMIN_SECRET=

# X Developer App (OAuth 2.0 PKCE, scopes: tweet.read users.read offline.access)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://prayforplagues.xyz/api/x/callback

# Optional: OpenSea collection link shown in the UI (defaults to https://opensea.io)
# NEXT_PUBLIC_OPENSEA_URL=https://opensea.io/collection/pray-for-plagues

# Server only — HMAC secret for the signed X session cookie (lib/session.ts).
# Without it, write routes fall back to unverified handles (legacy).
# Generate with: openssl rand -hex 32. Set in Vercel (Production + Preview)
# before merging, so auth is active from the first deploy with this code.
SESSION_SECRET=

# WalletConnect (QR / mobile pairing) — wired in lib/config.ts, project
# "Pray For Plagues" (cloud.walletconnect.com). Set its project ID here
# (local .env.local) and in Vercel env (production). When unset, the site
# works with injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Vial collection contract (Robinhood Chain 4663), once deployed and the
# mint is live on OpenSea. The Inventory/Lab ownership check reads
# balanceOf from this address; while unset it honestly reports NOT MINTED.
# NEXT_PUBLIC_VIAL_CONTRACT=
